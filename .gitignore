# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
ENV/

# VS Code / editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Local environment variables and credentials
.env
.env.*
!.env.example

# Logs and local recovery files
*.log
*.bak
*.bak_*
*~

# Jupyter
.ipynb_checkpoints/

# Testing
.pytest_cache/
.coverage
htmlcov/

# YOLO / ML training outputs
**/runs/
wandb/
mlruns/
*.cache

# Ignore model weights/exports by default; ship only the deployed detector
*.pt
*.weights
*.onnx
*.engine
*.torchscript
*.tflite
*.safetensors
best/
yolov8n/
/host/models/*
!/host/models/best.pt

# Generated preview images
class_preview/

# Downloaded datasets: keep bulk data out of Git, but allow instructions/manifest
/datasets/*
!/datasets/README.md
!/datasets/manifest.yaml
/dataset/
/data/

# Local calibration is hardware-specific; allow a guide and example template
/host/calibration/*
!/host/calibration/README.md
!/host/calibration/homography.example.json

# Generated simulation and test outputs
/host/tests/out/

# One-off patch helpers (keep source tooling only if deliberately maintained)
/apply_esp32_wifi_patch.py
/apply_rigid_mount_patch.py
/apply_wifi_heartbeat_patch.py

# Machine-specific firmware debugging artifacts
/firmware/arm_controller/debug.cfg
/firmware/arm_controller/debug_custom.json
/firmware/arm_controller/esp32.svd
